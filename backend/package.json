{
    "name": "backend",
    "version": "1.0.0",
    "description": "Mini Placement Portal — Express + TypeScript backend",
    "main": "dist/app.js",
    "scripts": {
        "dev": "npx ts-node-dev --respawn --transpile-only src/app.ts",
        "build": "npx tsc",
        "start": "node dist/app.js",
        "prisma:generate": "npx prisma generate",
        "prisma:migrate": "npx prisma migrate dev",
        "prisma:studio": "npx prisma studio"
    },
    "dependencies": {
        "@prisma/client": "^5.14.0",
        "bcryptjs": "^3.0.3",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "dotenv": "^18.0.5",
        "express": "^4.19.0",
        "jsonwebtoken": "^9.0.3"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.19",
        "@types/express": "^4.17.21",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^20.0.0",
        "prisma": "^5.14.0",
        "ts-node-dev": "^2.0.0",
        "typescript": "^5.0.0"
    }
}
